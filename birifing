<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Briefing de site profissional</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
:root{
  --navy:#14213D; --gold:#C9A227; --gold-soft:#F3E7B8;
  --bg:#EEF0F4; --surface:#FFFFFF; --ink:#1E2430; --muted:#626B7C; --line:#DDE1E8; --field:#F7F8FA;
  --ok:#2E7D5B; --focus:#3B5BDB;
  --side:#14213D; --side-ink:#D8DCE5; --side-muted:#8E97AB;
  --display:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --body:"Plus Jakarta Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0E1424; --surface:#172036; --ink:#E6E9F0; --muted:#9AA3B5; --line:#2A3550; --field:#1D2741;
    --gold-soft:#3A3218; --side:#0A0F1C; --focus:#8FA8FF;
  }
}
:root[data-theme="dark"]{
  --bg:#0E1424; --surface:#172036; --ink:#E6E9F0; --muted:#9AA3B5; --line:#2A3550; --field:#1D2741;
  --gold-soft:#3A3218; --side:#0A0F1C; --focus:#8FA8FF;
}
html{scroll-padding-top:env(safe-area-inset-top,0px); height:100%}
*,*::before,*::after{box-sizing:border-box}
body{margin:0; height:100%; background:var(--bg); color:var(--ink); font-family:var(--body); font-size:15px; line-height:1.55; -webkit-font-smoothing:antialiased}
button,input,textarea,select{font:inherit; color:inherit}
:focus-visible{outline:2px solid var(--focus); outline-offset:2px}

.app{display:grid; grid-template-columns:300px 1fr; height:100%}

/* sidebar */
.side{background:var(--side); color:var(--side-ink); display:flex; flex-direction:column; min-height:0}
.brand{padding:26px 24px 18px}
.brand h1{font-family:var(--display); font-weight:700; font-size:21px; line-height:1.15; margin:0; color:#fff}
.brand p{margin:6px 0 0; font-size:13px; color:var(--side-muted)}
.ring-wrap{display:flex; align-items:center; gap:14px; padding:4px 24px 20px; border-bottom:1px solid rgba(255,255,255,.08)}
.ring{width:58px; height:58px; flex:none}
.ring circle{fill:none; stroke-width:6}
.ring .bgc{stroke:rgba(255,255,255,.12)}
.ring .fg{stroke:var(--gold); stroke-linecap:round; transition:stroke-dashoffset .4s ease}
.ring text{fill:#fff; font-family:var(--display); font-weight:700; font-size:15px}
.ring-wrap small{display:block; font-size:12.5px; color:var(--side-muted)}
.ring-wrap strong{display:block; font-size:14px; color:#fff; font-weight:600}
nav.steps{overflow:auto; padding:10px 12px 20px; flex:1}
.step-btn{display:flex; align-items:center; gap:12px; width:100%; text-align:left; background:none; border:0; border-radius:10px; padding:9px 12px; cursor:pointer; color:var(--side-ink)}
.step-btn:hover{background:rgba(255,255,255,.05)}
.step-btn[aria-current="step"]{background:rgba(201,162,39,.14); color:#fff}
.step-num{flex:none; width:26px; height:26px; border-radius:50%; display:grid; place-items:center; font-size:12px; font-weight:700; border:1.5px solid rgba(255,255,255,.22); color:var(--side-muted)}
.step-btn[aria-current="step"] .step-num{border-color:var(--gold); color:var(--gold)}
.step-btn.done .step-num{background:var(--gold); border-color:var(--gold); color:var(--navy)}
.step-txt{flex:1; min-width:0}
.step-txt span{display:block; font-size:13.5px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.step-bar{height:3px; border-radius:2px; background:rgba(255,255,255,.1); margin-top:5px; overflow:hidden}
.step-bar i{display:block; height:100%; background:var(--gold); width:0; transition:width .3s}
.side-foot{padding:14px 24px 20px; border-top:1px solid rgba(255,255,255,.08); font-size:12.5px; color:var(--side-muted); display:flex; align-items:center; gap:8px}
.dot{width:8px; height:8px; border-radius:50%; background:#4CAF7D; flex:none}
.dot.saving{background:var(--gold)}

/* main */
.main{display:flex; flex-direction:column; min-height:0; min-width:0}
.topbar{position:sticky; top:0; z-index:5; background:var(--surface); border-bottom:1px solid var(--line)}
.top-inner{display:flex; align-items:center; gap:14px; padding:12px 32px}
.menu-btn{display:none; border:1px solid var(--line); background:var(--field); border-radius:8px; padding:7px 12px; cursor:pointer; font-weight:600; font-size:13.5px}
.top-title{font-size:13.5px; color:var(--muted); flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.top-title b{color:var(--ink); font-weight:600}
.pct{font-family:var(--display); font-weight:700; font-size:15px; color:var(--ink)}
.icon-btn{border:1px solid var(--line); background:transparent; border-radius:8px; padding:6px 10px; cursor:pointer; font-size:13px; color:var(--muted)}
.progress{height:5px; background:var(--line)}
.progress i{display:block; height:100%; width:0; background:linear-gradient(90deg,var(--navy),var(--gold)); transition:width .45s cubic-bezier(.2,.8,.2,1)}
:root[data-theme="dark"] .progress i{background:var(--gold)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .progress i{background:var(--gold)}}

.scroll{overflow:auto; flex:1; -webkit-overflow-scrolling:touch}
.content{max-width:780px; margin:0 auto; padding:40px 32px 48px}
.kicker{font-size:13px; font-weight:600; color:var(--gold); margin:0 0 6px}
.content h2{font-family:var(--display); font-weight:700; font-size:clamp(26px,3.4vw,34px); line-height:1.12; margin:0 0 10px; letter-spacing:-.01em}
.lead{color:var(--muted); margin:0 0 30px; max-width:62ch}
.group-title{font-family:var(--display); font-weight:600; font-size:18px; margin:34px 0 4px}
.group-hint{color:var(--muted); font-size:13.5px; margin:0 0 14px}

.field{margin:0 0 20px}
.field label.lb, .field .lb{display:block; font-weight:600; font-size:14px; margin-bottom:6px}
.field .hint{display:block; font-weight:400; color:var(--muted); font-size:13px; margin-top:2px}
.in{width:100%; background:var(--field); border:1.5px solid var(--line); border-radius:10px; padding:11px 13px; transition:border-color .15s, background .15s}
.in:focus{outline:none; border-color:var(--focus); background:var(--surface)}
textarea.in{min-height:96px; resize:vertical; line-height:1.5}
.grid2{display:grid; grid-template-columns:1fr 1fr; gap:0 18px}

.opts{display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:8px}
.opt{position:relative}
.opt input{position:absolute; opacity:0; inset:0; cursor:pointer}
.opt span{display:flex; gap:10px; align-items:flex-start; border:1.5px solid var(--line); background:var(--field); border-radius:10px; padding:10px 12px; font-size:14px; cursor:pointer; transition:border-color .15s, background .15s; height:100%}
.opt span::before{content:""; flex:none; width:17px; height:17px; margin-top:2px; border:1.5px solid var(--muted); border-radius:5px; background:var(--surface)}
.opt input[type=radio] + span::before{border-radius:50%}
.opt input:checked + span{border-color:var(--navy); background:var(--gold-soft)}
.opt input:checked + span::before{background:var(--navy); border-color:var(--navy); box-shadow:inset 0 0 0 3px var(--surface)}
:root[data-theme="dark"] .opt input:checked + span{border-color:var(--gold)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .opt input:checked + span{border-color:var(--gold)}}
.opt input:focus-visible + span{outline:2px solid var(--focus); outline-offset:2px}
.opt em{font-style:normal; color:var(--gold); font-weight:700; margin-left:2px}
.limit{font-size:12.5px; color:var(--muted); margin-top:6px}
.limit.warn{color:#C0392B}

.rep-item{border:1.5px solid var(--line); border-radius:14px; padding:18px 18px 4px; margin-bottom:14px; background:var(--surface)}
.rep-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:12px}
.rep-head b{font-family:var(--display); font-size:15.5px}
.rm{border:0; background:none; color:var(--muted); cursor:pointer; font-size:13px; text-decoration:underline; padding:4px}
.add{border:1.5px dashed var(--muted); background:transparent; border-radius:12px; padding:12px 16px; width:100%; cursor:pointer; font-weight:600; color:var(--ink)}
.add:hover{border-color:var(--navy); background:var(--field)}

.note{background:var(--field); border-left:3px solid var(--gold); border-radius:0 10px 10px 0; padding:13px 16px; font-size:14px; margin:6px 0 22px}
.note b{font-weight:700}
table.norms{width:100%; border-collapse:collapse; font-size:13.5px; margin:4px 0 8px}
.tbl-wrap{overflow-x:auto; margin-bottom:18px}
table.norms th{background:var(--navy); color:#fff; text-align:left; padding:9px 11px; font-weight:600}
table.norms td{border-bottom:1px solid var(--line); padding:9px 11px; vertical-align:top}

.timeline{list-style:none; padding:0; margin:0 0 26px; border-left:2px solid var(--line)}
.timeline li{position:relative; padding:0 0 14px 22px}
.timeline li::before{content:""; position:absolute; left:-7px; top:6px; width:12px; height:12px; border-radius:50%; background:var(--surface); border:2px solid var(--gold)}
.timeline b{display:block; font-size:14.5px}
.timeline span{color:var(--muted); font-size:13.5px}

.navrow{display:flex; justify-content:space-between; gap:12px; margin-top:36px; padding-top:22px; border-top:1px solid var(--line)}
.btn{border:0; border-radius:11px; padding:12px 22px; font-weight:700; cursor:pointer; font-size:14.5px}
.btn.primary{background:var(--navy); color:#fff}
.btn.primary:hover{filter:brightness(1.15)}
:root[data-theme="dark"] .btn.primary{background:var(--gold); color:var(--navy)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .btn.primary{background:var(--gold); color:var(--navy)}}
.btn.ghost{background:transparent; border:1.5px solid var(--line); color:var(--ink)}
.btn.gold{background:var(--gold); color:var(--navy)}

/* welcome */
.welcome h2{font-size:clamp(32px,5vw,48px)}
.facts{display:flex; flex-wrap:wrap; gap:26px; margin:6px 0 30px}
.facts div{font-size:13.5px; color:var(--muted)}
.facts strong{display:block; font-family:var(--display); font-size:22px; color:var(--ink)}
.steps-preview{columns:2; column-gap:28px; padding:0; margin:0 0 30px; list-style:none; font-size:14px}
.steps-preview li{break-inside:avoid; padding:5px 0; border-bottom:1px solid var(--line); display:flex; gap:10px}
.steps-preview li span{color:var(--gold); font-weight:700; width:22px}

/* review */
.rev-sec{border:1.5px solid var(--line); border-radius:14px; background:var(--surface); margin-bottom:12px; overflow:hidden}
.rev-sec summary{display:flex; align-items:center; gap:12px; padding:14px 18px; cursor:pointer; list-style:none; font-weight:600}
.rev-sec summary::-webkit-details-marker{display:none}
.rev-sec summary .rp{margin-left:auto; font-size:12.5px; color:var(--muted); font-weight:500}
.rev-body{padding:0 18px 14px}
.rev-row{padding:9px 0; border-top:1px solid var(--line); font-size:14px}
.rev-row b{display:block; font-size:12.5px; color:var(--muted); font-weight:600; margin-bottom:2px}
.rev-row p{margin:0; white-space:pre-wrap}
.rev-empty{color:var(--muted); font-style:italic; font-size:13.5px; padding:6px 0}
.exports{display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:10px; margin:6px 0 30px}
.exp{border:1.5px solid var(--line); background:var(--surface); border-radius:14px; padding:16px; text-align:left; cursor:pointer}
.exp:hover{border-color:var(--navy)}
.exp b{display:block; font-family:var(--display); font-size:16px; margin-bottom:3px}
.exp span{font-size:13px; color:var(--muted)}
.exp.main-exp{background:var(--navy); color:#fff; border-color:var(--navy)}
.exp.main-exp span{color:#C5CBD8}

.toast{position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom,0px)); transform:translate(-50%,20px); background:var(--ink); color:var(--bg); padding:11px 18px; border-radius:10px; font-size:14px; opacity:0; pointer-events:none; transition:.25s; z-index:50; max-width:90vw}
.toast.show{opacity:1; transform:translate(-50%,0)}
.scrim{display:none}

@media (max-width:900px){
  .app{grid-template-columns:1fr}
  .side{position:fixed; inset:0 auto 0 0; width:min(320px,86vw); z-index:30; transform:translateX(-100%); transition:transform .25s ease; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px)}
  .side.open{transform:none}
  .scrim{position:fixed; inset:0; background:rgba(8,12,24,.5); z-index:25}
  .scrim.open{display:block}
  .menu-btn{display:inline-block}
  .top-inner{padding:10px 16px; padding-top:calc(10px + env(safe-area-inset-top,0px))}
  .topbar{top:0}
  .content{padding:28px 18px 40px}
  .grid2{grid-template-columns:1fr}
  .steps-preview{columns:1}
}
@media (prefers-reduced-motion: reduce){*{transition:none!important}}

/* print */
.print-only{display:none}
@media print{
  body{background:#fff; color:#000; height:auto}
  .app{display:block}
  .side,.topbar,.navrow,.exports,.no-print,.toast{display:none!important}
  .scroll{overflow:visible}
  .content{max-width:none; padding:0}
  .rev-sec{border:0; break-inside:auto}
  .rev-sec .rev-body{display:block!important}
  details.rev-sec > *{display:block}
}
</style>
</head>
<body>
<div class="app">
  <aside class="side" id="side" aria-label="Etapas do briefing">
    <div class="brand">
      <h1>Briefing de site profissional</h1>
      <p>Escopo completo de conteúdo e estrutura</p>
    </div>
    <div class="ring-wrap">
      <svg class="ring" viewBox="0 0 60 60" aria-hidden="true">
        <circle class="bgc" cx="30" cy="30" r="25"/>
        <circle class="fg" id="ringFg" cx="30" cy="30" r="25" stroke-dasharray="157.08" stroke-dashoffset="157.08" transform="rotate(-90 30 30)"/>
        <text id="ringTxt" x="30" y="35" text-anchor="middle">0%</text>
      </svg>
      <div><strong id="ringCount">0 de 0 respostas</strong><small>Preenchidas até agora</small></div>
    </div>
    <nav class="steps" id="steps"></nav>
    <div class="side-foot"><span class="dot" id="saveDot"></span><span id="saveTxt">Salvo neste navegador</span></div>
  </aside>
  <div class="scrim" id="scrim"></div>

  <main class="main">
    <header class="topbar">
      <div class="top-inner">
        <button class="menu-btn" id="menuBtn" aria-controls="side" aria-expanded="false">Etapas</button>
        <div class="top-title" id="topTitle"></div>
        <span class="pct" id="pct">0%</span>
        <button class="icon-btn" id="themeBtn" title="Alternar tema claro/escuro" aria-label="Alternar tema">◐</button>
      </div>
      <div class="progress" role="progressbar" aria-label="Progresso do briefing" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="pbar"><i id="pfill"></i></div>
    </header>
    <div class="scroll" id="scroll">
      <div class="content" id="content"></div>
    </div>
  </main>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<input type="file" id="importFile" accept=".json,application/json" hidden>

<script>
/* ====================== SCHEMA ====================== */
const T=(id,label,o={})=>({id,type:'text',label,...o});
const A=(id,label,o={})=>({id,type:'textarea',label,...o});
const C=(id,label,options,o={})=>({id,type:'checks',label,options,...o});
const R=(id,label,options,o={})=>({id,type:'radio',label,options,...o});
const G=(title,hint)=>({type:'group',label:title,hint});
const N=(html)=>({type:'note',html});
const P=(id,label,item,fields,o={})=>({id,type:'repeat',label,item,fields,...o});

const SECTIONS=[
{id:'projeto',title:'Dados do projeto',lead:'Quem está contratando, quem aprova e qual é o prazo.',fields:[
  {row:[T('nome','Nome do profissional ou empresa'),T('fantasia','Nome como aparecerá no site')]},
  {row:[T('doc','CNPJ ou CPF'),T('responsavel','Responsável pelo projeto')]},
  {row:[T('cargo','Cargo / função'),T('whatsapp','Telefone / WhatsApp',{inputType:'tel'})]},
  {row:[T('email','E-mail',{inputType:'email'}),T('aprovador','Quem aprova as entregas?')]},
  {row:[T('dominio','Domínio existente',{ph:'www.seunome.com.br'}),T('siteAtual','Site atual (se houver)',{inputType:'url',ph:'https://'})]},
  {row:[T('lancamento','Data desejada de lançamento',{inputType:'date'}),T('motivo','Algum evento ou prazo motiva o projeto?')]},
  G('Situação atual'),
  C('situacao','Marque o que se aplica',['Não tenho site, será o primeiro','Tenho site e quero refazer do zero','Tenho site e quero apenas atualizar','Tenho apenas redes sociais','Tenho domínio registrado','Tenho e-mail profissional (@meudominio)']),
  A('funciona','O que funciona e o que não funciona no site atual?'),
]},
{id:'profissional',title:'Sobre o profissional',lead:'Estas respostas alimentam as páginas Sobre e Equipe e dão credibilidade ao site.',fields:[
  {row:[T('profissao','Profissão / especialidade principal'),T('registro','Registro profissional',{ph:'OAB, CRM, CRP, CREA, CRC, CRN…'})]},
  {row:[T('inicio','Ano de início da atuação',{inputType:'number',ph:'2012'}),T('regiao','Cidades e regiões atendidas')]},
  R('modalidade','Como você atende?',['Presencial','Online','Presencial e online']),
  {row:[T('endereco','Endereço do local de atendimento'),T('horario','Horário de atendimento',{ph:'Seg a sex, 8h às 18h'})]},
  A('formacao','Formação acadêmica',{hint:'Graduação, pós, mestrado, doutorado, com instituição e ano.'}),
  A('cursos','Cursos, certificações e especializações'),
  A('premios','Prêmios, publicações, palestras, entidades'),
  G('Sua história'),
  A('historia','Por que escolheu essa profissão? Conte sua trajetória.',{rows:5}),
  A('metodo','Como você trabalha? Método, abordagem, filosofia.',{rows:5}),
  A('numeros','Números e marcos da carreira',{hint:'Clientes atendidos, casos, anos, projetos entregues.'}),
  G('Equipe','Deixe vazio se você trabalha sozinho.'),
  P('equipe','Equipe','Integrante',[T('nome','Nome'),T('cargo','Cargo / especialidade'),T('registro','Registro profissional'),A('bio','Mini bio (2 a 3 linhas)')]),
]},
{id:'posicionamento',title:'Posicionamento e diferenciais',lead:'Como você quer ser percebido. É a base da mensagem principal do site.',fields:[
  A('frase','Em uma frase: o que você faz, para quem e qual resultado entrega?',{rows:3}),
  {row:[A('missao','Missão',{rows:3}),A('visao','Visão',{rows:3})]},
  A('valores','Valores (3 a 5 palavras ou frases)',{rows:2}),
  A('diferenciais','Seus 3 principais diferenciais em relação a outros profissionais',{rows:4}),
  A('elogios','O que os clientes mais elogiam no seu trabalho?'),
  A('evitarImagem','Que imagem você não quer transmitir?',{rows:2}),
  G('Personalidade da marca'),
  C('personalidade','Escolha até 4',['Sério e formal','Próximo e acolhedor','Técnico e especialista','Moderno e inovador','Tradicional e sólido','Sofisticado / premium','Acessível / popular','Didático e educativo','Dinâmico e jovem','Discreto e sóbrio'],{max:4}),
  G('Tom de voz do texto'),
  C('tom','Marque as preferências',['Tratar o leitor por “você”','Tratar o leitor por “o senhor / a senhora”','Texto em 1ª pessoa (“eu atendo…”)','Texto em 1ª pessoa do plural (“nós…”)','Texto em 3ª pessoa (“Dra. Ana atende…”)','Evitar jargão técnico']),
]},
{id:'objetivos',title:'Objetivos do site',lead:'O objetivo principal define o botão de ação de todas as páginas.',fields:[
  C('objetivos','O que o site precisa fazer por você?',['Gerar contatos e orçamentos','Agendar consultas ou reuniões','Levar o visitante ao WhatsApp','Transmitir autoridade e credibilidade','Apresentar serviços em detalhe','Mostrar portfólio e casos de sucesso','Atrair clientes pelo Google','Receber tráfego de anúncios','Publicar artigos educativos','Captar e-mails','Vender cursos, e-books ou produtos','Recrutar profissionais ou parceiros','Área restrita para clientes','Atender clientes de outras cidades ou países']),
  {row:[T('acaoPrincipal','A ação nº 1 que o visitante deve realizar'),T('textoBotao','Texto do botão principal',{ph:'Agende sua consulta'})]},
  A('metas','Metas mensuráveis',{hint:'Ex.: 20 contatos por mês; primeira página do Google para “advogado trabalhista em Palmas”.'}),
  A('canais','Como você recebe clientes hoje?',{hint:'Indicação, Instagram, Google, convênios…',rows:2}),
]},
{id:'publico',title:'Público-alvo',lead:'Quanto melhor você descrever o cliente, mais o texto vai falar com ele.',fields:[
  A('perfil','Quem é o cliente ideal?',{hint:'Idade, profissão, renda, região, pessoa física ou empresa.'}),
  A('dor','Que problema ou necessidade leva essa pessoa a procurar você?'),
