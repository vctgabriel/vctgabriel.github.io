/* ====================== STATE ====================== */
const KEY='briefing-site-profissional-v1';
let S={}; let step=-1; // -1 = welcome, SECTIONS.length = review
try{ const raw=localStorage.getItem(KEY); if(raw){ const o=JSON.parse(raw); S=o.data||{}; step=typeof o.step==='number'?o.step:-1; } }catch(e){}
const hasSaved=()=>Object.keys(S).length>0;

const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

function flat(fields){ const out=[]; fields.forEach(f=>{ if(f.row) out.push(...f.row); else out.push(f); }); return out; }
function answerable(sec){ return flat(sec.fields).filter(f=>['text','textarea','checks','radio','repeat'].includes(f.type)); }
function filled(f,val){
  if(f.type==='checks') return Array.isArray(val)&&val.length>0;
  if(f.type==='repeat') return Array.isArray(val)&&val.some(it=>it&&Object.values(it).some(v=>String(v||'').trim()));
  return val!=null && String(val).trim()!=='';
}
function secProgress(sec){ const fs=answerable(sec); const d=S[sec.id]||{}; const n=fs.filter(f=>filled(f,d[f.id])).length; return {n,t:fs.length}; }
function totalProgress(){ let n=0,t=0; SECTIONS.forEach(s=>{const p=secProgress(s); n+=p.n; t+=p.t;}); return {n,t,pct:t?Math.round(n/t*100):0}; }

let saveTimer;
function save(){
  $('#saveDot').classList.add('saving'); $('#saveTxt').textContent='Salvando…';
  clearTimeout(saveTimer);
  saveTimer=setTimeout(()=>{
    try{ localStorage.setItem(KEY,JSON.stringify({data:S,step,ts:Date.now()})); $('#saveTxt').textContent='Salvo neste navegador'; }
    catch(e){ $('#saveTxt').textContent='Não foi possível salvar aqui. Exporte um backup.'; }
    $('#saveDot').classList.remove('saving');
  },400);
}

/* ====================== RENDER: SIDEBAR & PROGRESS ====================== */
function renderSteps(){
  const nav=$('#steps'); let h='';
  SECTIONS.forEach((s,i)=>{
    const p=secProgress(s); const done=p.t&&p.n===p.t;
    h+=`<button class="step-btn ${done?'done':''}" data-go="${i}" ${i===step?'aria-current="step"':''}>
      <span class="step-num">${done?'✓':i+1}</span>
      <span class="step-txt"><span>${esc(s.title)}</span><span class="step-bar"><i style="width:${p.t?p.n/p.t*100:0}%"></i></span></span></button>`;
  });
  h+=`<button class="step-btn" data-go="${SECTIONS.length}" ${step===SECTIONS.length?'aria-current="step"':''}><span class="step-num">★</span><span class="step-txt"><span>Revisar e exportar</span></span></button>`;
  nav.innerHTML=h;
}
function updateProgress(){
  const tp=totalProgress();
  $('#pfill').style.width=tp.pct+'%'; $('#pbar').setAttribute('aria-valuenow',tp.pct);
  $('#pct').textContent=tp.pct+'%'; $('#ringTxt').textContent=tp.pct+'%';
  $('#ringFg').style.strokeDashoffset=157.08*(1-tp.pct/100);
  $('#ringCount').textContent=`${tp.n} de ${tp.t} respostas`;
  document.querySelectorAll('#steps .step-btn').forEach((b,i)=>{
    const s=SECTIONS[i]; if(!s) return; const p=secProgress(s); const done=p.t&&p.n===p.t;
    b.classList.toggle('done',!!done); b.querySelector('.step-num').textContent=done?'✓':i+1;
    b.querySelector('.step-bar i').style.width=(p.t?p.n/p.t*100:0)+'%';
  });
  const live=document.querySelector('[data-secprog]'); if(live&&SECTIONS[step]){const p=secProgress(SECTIONS[step]); live.textContent=`${p.n} de ${p.t} itens preenchidos nesta etapa`;}
}

/* ====================== RENDER: FIELDS ====================== */
let uid=0;
function fieldHTML(f,val,path){
  const id='f'+(uid++); const hint=f.hint?`<span class="hint">${esc(f.hint)}</span>`:'';
  const dp=`data-path="${esc(path)}" data-type="${f.type}"`;
  if(f.type==='group') return `<h3 class="group-title">${esc(f.label)}</h3>${f.hint?`<p class="group-hint">${esc(f.hint)}</p>`:''}`;
  if(f.type==='note') return `<div class="note">${f.html}</div>`;
  if(f.type==='timeline') return `<ol class="timeline">${TIMELINE.map(t=>`<li><b>${t[0]}</b><span>${t[1]}</span></li>`).join('')}</ol>`;
  if(f.type==='norms') return `<div class="tbl-wrap"><table class="norms"><thead><tr><th>Área</th><th>Norma de referência</th><th>Pontos de atenção</th></tr></thead><tbody>
    <tr><td>Advocacia</td><td>Código de Ética da OAB e Provimento 205/2021</td><td>Caráter informativo, sem captação de clientela nem promessa de resultado.</td></tr>
    <tr><td>Medicina</td><td>Código de Ética Médica e Resolução CFM 2.336/2023</td><td>Exibir CRM e RQE; vedadas promessas de resultado e sensacionalismo.</td></tr>
    <tr><td>Psicologia</td><td>Código de Ética do Psicólogo (CFP)</td><td>Exibir CRP; cuidado com depoimentos, promessas de cura e sigilo.</td></tr>
    <tr><td>Outras</td><td>Normas do conselho respectivo (CFO, CFN, COFFITO, CFC, CONFEA…)</td><td>Verificar regras sobre antes/depois, preços, depoimentos e títulos.</td></tr>
    </tbody></table></div><p class="group-hint">As normas mudam; confirme a versão vigente no site do seu conselho.</p>`;
  if(f.type==='text'){
    return `<div class="field"><label class="lb" for="${id}">${esc(f.label)}${hint}</label><input class="in" id="${id}" type="${f.inputType||'text'}" ${dp} value="${esc(val||'')}" placeholder="${esc(f.ph||'')}"></div>`;
  }
  if(f.type==='textarea'){
    return `<div class="field"><label class="lb" for="${id}">${esc(f.label)}${hint}</label><textarea class="in" id="${id}" rows="${f.rows||4}" ${dp} placeholder="${esc(f.ph||'')}">${esc(val||'')}</textarea></div>`;
  }
  if(f.type==='checks'||f.type==='radio'){
    const arr=f.type==='checks'?(Array.isArray(val)?val:[]):[val];
    const inType=f.type==='checks'?'checkbox':'radio';
    const opts=f.options.map(o=>{
      const lab=esc(o).replace('★','<em>★</em>');
      return `<label class="opt"><input type="${inType}" name="${id}" value="${esc(o)}" ${arr.includes(o)?'checked':''} ${dp} ${f.max?`data-max="${f.max}"`:''}><span>${lab}</span></label>`;
    }).join('');
    const lim=f.max?`<div class="limit" data-limit>${arr.length} de ${f.max} escolhidos</div>`:'';
    return `<fieldset class="field" style="border:0;padding:0;margin:0 0 20px"><legend class="lb">${esc(f.label)}${hint}</legend><div class="opts">${opts}</div>${lim}</fieldset>`;
  }
  if(f.type==='repeat'){
    let items=Array.isArray(val)?val:[];
    let h='';
    items.forEach((it,i)=>{
      h+=`<div class="rep-item"><div class="rep-head"><b>${esc(f.item)} ${i+1}</b><button class="rm" data-rm="${esc(path)}" data-idx="${i}">Remover</button></div>`;
      h+=fieldsHTML(f.fields,it||{},`${path}.${i}`);
      h+=`</div>`;
    });
    h+=`<button class="add" data-add="${esc(path)}">+ Adicionar ${esc(f.item.toLowerCase())}</button>`;
    return `<div class="field">${h}</div>`;
  }
  return '';
}
function fieldsHTML(fields,data,base){
  return fields.map(f=>{
    if(f.row) return `<div class="grid2">${f.row.map(x=>fieldHTML(x,data[x.id],`${base}.${x.id}`)).join('')}</div>`;
    return fieldHTML(f,f.id?data[f.id]:null,f.id?`${base}.${f.id}`:base);
  }).join('');
}

/* path helpers: "secId.field" or "secId.repeat.0.sub" */
function getAt(path){ return path.split('.').reduce((o,k)=>o==null?undefined:o[k],S); }
function setAt(path,v){
  const ks=path.split('.'); let o=S;
  ks.slice(0,-1).forEach((k,i)=>{ if(o[k]==null) o[k]=/^\d+$/.test(ks[i+1])?[]:{}; o=o[k]; });
  o[ks[ks.length-1]]=v;
}

/* ====================== RENDER: PAGES ====================== */
function render(){
  uid=0; const c=$('#content');
  if(step<0) c.innerHTML=welcomeHTML();
  else if(step>=SECTIONS.length) c.innerHTML=reviewHTML();
  else{
    const s=SECTIONS[step]; const p=secProgress(s);
    // ensure repeat with start
    flat(s.fields).forEach(f=>{ if(f.type==='repeat'&&f.start&&!(S[s.id]&&Array.isArray(S[s.id][f.id])&&S[s.id][f.id].length)){ setAt(`${s.id}.${f.id}`,[{}]); } });
    c.innerHTML=`<p class="kicker">Etapa ${step+1} de ${SECTIONS.length}</p><h2>${esc(s.title)}</h2><p class="lead">${esc(s.lead)} <br><span data-secprog style="font-size:13px">${p.n} de ${p.t} itens preenchidos nesta etapa</span></p>
      ${fieldsHTML(s.fields,S[s.id]||{},s.id)}
      <div class="navrow"><button class="btn ghost" data-go="${step-1}">Voltar</button><button class="btn primary" data-go="${step+1}">${step===SECTIONS.length-1?'Revisar respostas':'Próxima etapa'}</button></div>`;
  }
  const title=step<0?'Boas-vindas':step>=SECTIONS.length?'Revisar e exportar':`<b>${esc(SECTIONS[step].title)}</b> · etapa ${step+1} de ${SECTIONS.length}`;
  $('#topTitle').innerHTML=title;
  renderSteps(); updateProgress();
  $('#scroll').scrollTop=0;
  const cur=document.querySelector('#steps [aria-current="step"]'); if(cur) cur.scrollIntoView({block:'nearest'});
}

function welcomeHTML(){
  const tp=totalProgress();
  return `<div class="welcome"><p class="kicker">Briefing de projeto</p>
  <h2>Vamos planejar o seu site profissional.</h2>
  <p class="lead">Este formulário reúne tudo o que é preciso para escrever, desenhar e desenvolver o site: quem você é, para quem fala, o que cada página vai dizer e quais recursos o site terá. Suas respostas ficam salvas automaticamente neste navegador, então você pode parar e voltar quando quiser.</p>
  <div class="facts"><div><strong>${SECTIONS.length}</strong>etapas</div><div><strong>~40 min</strong>para completar</div><div><strong>PDF</strong>gerado no final</div></div>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:34px">
    <button class="btn primary" data-go="${hasSaved()?firstIncomplete():0}">${hasSaved()?`Continuar de onde parei (${tp.pct}%)`:'Começar o briefing'}</button>
    <button class="btn ghost" data-action="import">Importar backup</button>
  </div>
  <ol class="steps-preview">${SECTIONS.map((s,i)=>`<li><span>${i+1}</span>${esc(s.title)}</li>`).join('')}</ol>
  <div class="note"><b>Escreva do seu jeito.</b> Não se preocupe com o texto final. Prefira fatos a adjetivos: números, casos, métodos, formação, prazos e regiões atendidas rendem textos muito melhores do que “atendimento de qualidade”.</div></div>`;
}
function firstIncomplete(){ const i=SECTIONS.findIndex(s=>{const p=secProgress(s); return p.n<p.t;}); return i<0?SECTIONS.length:i; }

function display(f,v){
  if(f.type==='checks') return (v||[]).join('\n');
  if(f.type==='repeat') return null;
  if(f.inputType==='date'&&v){ const [y,m,d]=v.split('-'); return `${d}/${m}/${y}`; }
  return v;
}
function reviewHTML(){
  const tp=totalProgress();
  let h=`<p class="kicker">Última etapa</p><h2>Revisar e exportar</h2>
  <p class="lead">Você preencheu ${tp.n} de ${tp.t} itens (${tp.pct}%). Confira as respostas abaixo e gere o PDF para enviar à equipe do projeto.</p>
  <div class="exports">
    <button class="exp main-exp" data-action="pdf"><b>Baixar PDF</b><span>Documento formatado com todas as respostas</span></button>
    <button class="exp" data-action="md"><b>Baixar texto</b><span>Arquivo .md para colar em outro lugar</span></button>
    <button class="exp" data-action="json"><b>Salvar backup</b><span>Arquivo .json para continuar em outro aparelho</span></button>
    <button class="exp" data-action="import"><b>Importar backup</b><span>Carregar um .json salvo antes</span></button>
  </div>`;
  SECTIONS.forEach((s,i)=>{
    const p=secProgress(s); const d=S[s.id]||{};
    h+=`<details class="rev-sec" ${i<2?'open':''}><summary><span class="step-num" style="border-color:var(--line);color:var(--muted)">${i+1}</span>${esc(s.title)}<span class="rp">${p.n}/${p.t}</span></summary><div class="rev-body">`;
    let any=false;
    flat(s.fields).forEach(f=>{
      if(!['text','textarea','checks','radio','repeat'].includes(f.type)) return;
      const v=d[f.id]; if(!filled(f,v)) return; any=true;
      if(f.type==='repeat'){
        v.forEach((it,k)=>{ if(!it||!Object.values(it).some(x=>String(x||'').trim())) return;
          const sub=flat(f.fields).filter(x=>filled(x,it[x.id])).map(x=>`<b>${esc(x.label)}</b><p>${esc(display(x,it[x.id]))}</p>`).join('');
          h+=`<div class="rev-row"><b style="color:var(--ink);font-size:13.5px">${esc(f.item)} ${k+1}</b>${sub}</div>`;});
      } else h+=`<div class="rev-row"><b>${esc(f.label)}</b><p>${esc(display(f,v))}</p></div>`;
    });
    if(!any) h+=`<div class="rev-empty">Nada preenchido ainda. <button class="rm" data-go="${i}">Preencher esta etapa</button></div>`;
    else h+=`<div style="padding-top:8px"><button class="rm" data-go="${i}">Editar esta etapa</button></div>`;
    h+=`</div></details>`;
  });
  h+=`<div class="navrow"><button class="btn ghost" data-go="${SECTIONS.length-1}">Voltar</button><button class="btn ghost no-print" data-action="reset" style="color:#C0392B">Apagar tudo e recomeçar</button></div>`;
  return h;
}

/* ====================== EVENTS ====================== */
document.addEventListener('input',e=>{
  const el=e.target; const path=el.dataset.path; if(!path) return;
  const type=el.dataset.type;
  if(type==='checks'){
    const max=+el.dataset.max||0; let arr=Array.isArray(getAt(path))?[...getAt(path)]:[];
    if(el.checked){ if(max&&arr.length>=max){ el.checked=false; const lim=el.closest('fieldset').querySelector('[data-limit]'); lim.classList.add('warn'); lim.textContent=`Máximo de ${max}. Desmarque uma opção para trocar.`; return; } arr.push(el.value); }
    else arr=arr.filter(x=>x!==el.value);
    setAt(path,arr);
    const lim=el.closest('fieldset').querySelector('[data-limit]'); if(lim){lim.classList.remove('warn'); lim.textContent=`${arr.length} de ${max} escolhidos`;}
  } else if(type==='radio'){ setAt(path,el.value); }
  else setAt(path,el.value);
  save(); updateProgress();
});
document.addEventListener('click',e=>{
  const go=e.target.closest('[data-go]');
  if(go){ e.preventDefault(); const n=+go.dataset.go; step=Math.max(-1,Math.min(SECTIONS.length,n)); closeMenu(); save(); render(); return; }
  const add=e.target.closest('[data-add]');
  if(add){ e.preventDefault(); const p=add.dataset.add; const arr=Array.isArray(getAt(p))?getAt(p):[]; arr.push({}); setAt(p,arr); save(); const y=$('#scroll').scrollTop; render(); $('#scroll').scrollTop=y;
    const items=document.querySelectorAll(`[data-path^="${CSS.escape(p)}."]`); const last=[...items].filter(x=>x.dataset.path.startsWith(`${p}.${arr.length-1}.`))[0]; if(last){ last.focus({preventScroll:false}); } return; }
  const rm=e.target.closest('[data-rm]');
  if(rm){ e.preventDefault(); const p=rm.dataset.rm; const arr=getAt(p)||[]; arr.splice(+rm.dataset.idx,1); setAt(p,arr); save(); const y=$('#scroll').scrollTop; render(); $('#scroll').scrollTop=y; toast('Item removido'); return; }
  const act=e.target.closest('[data-action]');
  if(act){ e.preventDefault(); const a=act.dataset.action;
    if(a==='pdf') exportPDF(); if(a==='md') exportMD(); if(a==='json') exportJSON(); if(a==='import') $('#importFile').click();
    if(a==='reset'){ if(confirm('Apagar todas as respostas deste navegador? Isso não pode ser desfeito.')){ S={}; step=-1; try{localStorage.removeItem(KEY);}catch(_){} render(); toast('Respostas apagadas'); } }
  }
});
$('#importFile').addEventListener('change',async e=>{
  const f=e.target.files[0]; if(!f) return;
  try{ const o=JSON.parse(await f.text()); if(!o||typeof o!=='object'||!o.data) throw 0; S=o.data; step=firstIncomplete(); save(); render(); toast('Backup importado'); }
  catch(_){ toast('Este arquivo não é um backup válido do briefing.'); }
  e.target.value='';
});
function openMenu(){ $('#side').classList.add('open'); $('#scrim').classList.add('open'); $('#menuBtn').setAttribute('aria-expanded','true'); }
function closeMenu(){ $('#side').classList.remove('open'); $('#scrim').classList.remove('open'); $('#menuBtn').setAttribute('aria-expanded','false'); }
$('#menuBtn').onclick=openMenu; $('#scrim').onclick=closeMenu;
document.addEventListener('keydown',e=>{ if(e.key==='Escape') closeMenu(); });
$('#themeBtn').onclick=()=>{
  const r=document.documentElement; const dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;
  r.dataset.theme=dark?'light':'dark'; try{localStorage.setItem(KEY+'-theme',r.dataset.theme);}catch(_){}
};
try{ const th=localStorage.getItem(KEY+'-theme'); if(th) document.documentElement.dataset.theme=th; }catch(_){}

let tt; function toast(m){ const t=$('#toast'); t.textContent=m; t.classList.add('show'); clearTimeout(tt); tt=setTimeout(()=>t.classList.remove('show'),2800); }

/* ====================== EXPORT ====================== */
let downloadsP=null;
function getDownloads(){ if(!downloadsP) downloadsP=(window.claude&&window.claude.use)?window.claude.use('downloads').catch(()=>null):Promise.resolve(null); return downloadsP; }
async function offer(filename,data,fallbackMime){
  const dl=await getDownloads();
  if(dl){
    try{ await dl.save({filename,data}); toast('Arquivo pronto: '+filename); return; }
    catch(err){ if(err&&err.code==='declined') return; if(err&&err.code==='rate_limited'){ toast('Já existe um pedido de download aberto.'); return; } }
  }
  // fallback (página fora do visualizador do Claude)
  try{ const blob=data instanceof Blob?data:new Blob([data],{type:fallbackMime}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=filename; document.body.appendChild(a); a.click(); a.remove(); }
  catch(_){ toast('O download não está disponível aqui. Use Imprimir > Salvar como PDF.'); }
}
const clientName=()=>((S.projeto||{}).fantasia||(S.projeto||{}).nome||'cliente').trim();
const slug=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]+/g,'-').replace(/^-|-$/g,'').toLowerCase()||'cliente';

function collect(){
  return SECTIONS.map((s,i)=>{
    const d=S[s.id]||{}; const rows=[];
    flat(s.fields).forEach(f=>{
      if(!['text','textarea','checks','radio','repeat'].includes(f.type)) return;
      const v=d[f.id]; if(!filled(f,v)) return;
      if(f.type==='repeat') v.forEach((it,k)=>{ if(!it||!Object.values(it).some(x=>String(x||'').trim())) return;
        rows.push({sub:`${f.item} ${k+1}`}); flat(f.fields).forEach(x=>{ if(filled(x,it[x.id])) rows.push({label:x.label,value:display(x,it[x.id]),indent:true}); }); });
      else rows.push({label:f.label,value:display(f,v),list:f.type==='checks'});
    });
    return {n:i+1,title:s.title,rows};
  });
}
function exportJSON(){ offer(`briefing-${slug(clientName())}.json`,JSON.stringify({app:'briefing-site-profissional',version:1,exported:new Date().toISOString(),data:S},null,2),'application/json'); }
function exportMD(){
  let md=`# Briefing de website profissional\n\n**Cliente:** ${clientName()}  \n**Gerado em:** ${new Date().toLocaleDateString('pt-BR')}  \n**Preenchimento:** ${totalProgress().pct}%\n\n`;
  collect().forEach(sec=>{ md+=`## ${sec.n}. ${sec.title}\n\n`; if(!sec.rows.length){md+='_Não preenchido._\n\n';return;}
    sec.rows.forEach(r=>{ if(r.sub){md+=`### ${r.sub}\n\n`;return;} md+=`**${r.label}**\n\n${r.list?String(r.value).split('\n').map(x=>'- '+x).join('\n'):r.value}\n\n`; }); });
  offer(`briefing-${slug(clientName())}.md`,md,'text/markdown');
}
function pdfSafe(s){ return String(s??'').replace(/[“”]/g,'"').replace(/[‘’]/g,"'").replace(/[–—]/g,'-').replace(/…/g,'...').replace(/★/g,'*').replace(/[^\x00-\xFF•]/g,''); }
async function exportPDF(){
  if(!window.jspdf){ toast('Gerador de PDF indisponível. Use Imprimir > Salvar como PDF.'); setTimeout(()=>window.print(),600); return; }
  toast('Gerando PDF…');
  const {jsPDF}=window.jspdf; const doc=new jsPDF({unit:'mm',format:'a4'});
  const W=210,H=297,M=18,CW=W-2*M; const navy=[20,33,61], gold=[201,162,39], ink=[30,36,48], muted=[98,107,124];
  // capa
  doc.setFillColor(...navy); doc.rect(0,0,W,H,'F');
  doc.setFillColor(...gold); doc.rect(M,70,28,2.2,'F');
  doc.setTextColor(185,191,204); doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.text('DOCUMENTO DE BRIEFING',M,62);
  doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(34); doc.text('Briefing de',M,92); doc.text('Website Profissional',M,107);
  doc.setFont('helvetica','normal'); doc.setFontSize(13); doc.setTextColor(217,220,227);
  doc.text(pdfSafe(clientName()),M,124);
  const pr=(S.profissional||{}); if(pr.profissao) doc.text(pdfSafe(pr.profissao),M,132);
  doc.setDrawColor(...gold); doc.setLineWidth(.6); doc.rect(M,232,CW,34);
  doc.setFontSize(9); doc.setTextColor(...gold); doc.setFont('helvetica','bold');
  doc.text('RESPONSÁVEL',M+6,243); doc.text('DATA',M+6,252); doc.text('PREENCHIMENTO',M+6,261);
  doc.setFont('helvetica','normal'); doc.setTextColor(255,255,255); doc.setFontSize(10);
  doc.text(pdfSafe((S.projeto||{}).responsavel||'-'),M+48,243); doc.text(new Date().toLocaleDateString('pt-BR'),M+48,252); doc.text(totalProgress().pct+'% completo',M+48,261);

  let y=0; let page=1;
  const header=()=>{ doc.setFillColor(...navy); doc.rect(0,0,W,11,'F'); doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(8); doc.text('BRIEFING  •  WEBSITE PROFISSIONAL',M,7); doc.setFillColor(...gold); doc.rect(W-M-16,0,16,11,'F'); doc.setTextColor(...navy); doc.setFontSize(9); doc.text(String(page),W-M-8,7,{align:'center'}); doc.setTextColor(...muted); doc.setFont('helvetica','normal'); doc.setFontSize(7.5); doc.text(pdfSafe('Cliente: '+clientName()),M,H-8); doc.text('Documento confidencial',W-M,H-8,{align:'right'}); y=24; };
  const newPage=()=>{ doc.addPage(); page++; header(); };
  const need=h=>{ if(y+h>H-16) newPage(); };
  newPage();
  collect().forEach(sec=>{
    need(22);
    doc.setFont('helvetica','bold'); doc.setFontSize(15); doc.setTextColor(...gold); doc.text(String(sec.n).padStart(2,'0'),M,y);
    doc.setTextColor(...navy); doc.text(pdfSafe(sec.title),M+11,y); y+=2.5; doc.setDrawColor(...gold); doc.setLineWidth(.5); doc.line(M,y,W-M,y); y+=7;
    if(!sec.rows.length){ doc.setFont('helvetica','italic'); doc.setFontSize(9.5); doc.setTextColor(...muted); doc.text('Não preenchido.',M,y); y+=10; return; }
    sec.rows.forEach(r=>{
      if(r.sub){ need(12); doc.setFillColor(244,241,232); doc.rect(M,y-4.5,CW,7,'F'); doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.setTextColor(...navy); doc.text(pdfSafe(r.sub),M+2,y); y+=7; return; }
      const x=r.indent?M+4:M, w=r.indent?CW-4:CW;
      doc.setFont('helvetica','bold'); doc.setFontSize(8.6); const lab=doc.splitTextToSize(pdfSafe(r.label),w);
      doc.setFont('helvetica','normal'); doc.setFontSize(10);
      const val=r.list?String(r.value).split('\n').map(v=>'•  '+v).join('\n'):String(r.value);
      const lines=doc.splitTextToSize(pdfSafe(val),w);
      need(lab.length*4+Math.min(lines.length,3)*4.6+4);
      doc.setFont('helvetica','bold'); doc.setFontSize(8.6); doc.setTextColor(...muted); doc.text(lab,x,y); y+=lab.length*4+.6;
      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(...ink);
      lines.forEach(l=>{ need(5); doc.text(l,x,y); y+=4.6; });
      y+=3.2;
    });
    y+=5;
  });
  // assinaturas
  need(45); y+=10; doc.setFont('helvetica','normal'); doc.setFontSize(9.5); doc.setTextColor(...ink);
  doc.text(doc.splitTextToSize('Declaro que as informações deste briefing são verdadeiras e representam as necessidades do projeto. Alterações de escopo após a aprovação poderão impactar prazo e investimento.',CW),M,y); y+=24;
  doc.setDrawColor(...navy); doc.setLineWidth(.4); doc.line(M,y,M+75,y); doc.line(W-M-75,y,W-M,y); y+=5; doc.setFontSize(8.5); doc.setTextColor(...muted);
  doc.text('Cliente / Responsável',M,y); doc.text('Agência / Desenvolvedor',W-M-75,y);
  const blob=doc.output('blob');
  offer(`briefing-${slug(clientName())}.pdf`,blob,'application/pdf');
}

render();
</script>
